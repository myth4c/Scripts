    local background = square(-5, -5, viewportX + 10, viewportY + 10, Color3.fromRGB(0,0,0), 900)
    local accent = square(math.floor(viewportX / 2) - 110, math.floor(viewportY / 2) - 76, 220, 4, Color3.fromRGB(0,200,105), 901)
    local title = textLabel("laced.lol Lite", viewportX / 2, math.floor(viewportY / 2) - 55, 28, true, Color3.fromRGB(255,255,255), 903)
    local message = textLabel("bud, join the discord server for the script", viewportX / 2, math.floor(viewportY / 2) - 8, 20, true, Color3.fromRGB(220,225,235), 903)
    local linkText = textLabel(DISCORD_LINK, viewportX / 2, math.floor(viewportY / 2) + 28, 16, true, Color3.fromRGB(0,215,115), 903)
    local copyButton = square(buttonX, buttonY, buttonWidth, buttonHeight, Color3.fromRGB(0,180,95), 902)
    local copyText = textLabel("Copy Discord Link", viewportX / 2, buttonY + 13, 18, true, Color3.fromRGB(255,255,255), 903)

    notify("bud, join the discord server for the script", "laced.lol", 10)

    local Mouse = nil
    pcall(function() Mouse = LocalPlayer:GetMouse() end)
    local startedAt = os.clock()
    local wasPressed = false

    while os.clock() - startedAt < 10 do
        pcall(function()
            local viewport = game.Workspace.CurrentCamera.ViewportSize
            if viewport and viewport.X and viewport.Y
                and (viewport.X ~= viewportX or viewport.Y ~= viewportY) then
                viewportX, viewportY = viewport.X, viewport.Y
                buttonX = math.floor((viewportX - buttonWidth) / 2)
                buttonY = math.floor(viewportY / 2) + 62
