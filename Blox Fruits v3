-- Auto Farm Fruits
task.spawn(function()
    while true do
        if S.autoFarmFruits then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart") or nil
            local hrpPosition = safePosition(hrp)
            local bestPart, bestDistance = nil, math.huge
            if hrp and hrpPosition then
                for _, fruit in pairs(getWorkspaceFruits()) do
                    local position = safePosition(fruit.part)
                    if position then
                        local dx = position.X - hrpPosition.X
                        local dy = position.Y - hrpPosition.Y
                        local dz = position.Z - hrpPosition.Z
                        local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
                        if distance < bestDistance then bestPart, bestDistance = fruit.part, distance end
                    end
                end
            end

            if bestPart and hrp then
                S.fruitPriorityActive = true
                local position = safePosition(bestPart)
                if position then
                    tweenTo(hrp, Vector3.new(position.X, position.Y + 3, position.Z), function()
                        local okParent, parent = pcall(function() return bestPart.Parent end)
                        return S.autoFarmFruits and okParent and parent ~= nil
                    end)
                    if S.autoFarmFruits then
                        task.wait(1)
                        pressWeaponSlot(S.weaponSlot)
                    end
                end
                local waitStarted = os.clock()
                while S.autoFarmFruits and os.clock() - waitStarted < 3 do
                    local okParent, parent = pcall(function() return bestPart.Parent end)
                    if not okParent or not parent then break end
                    task.wait(0.05)
                end
                S.fruitPriorityActive = false
            else
                S.fruitPriorityActive = false
            end
        end
        task.wait(0.1)
    end
end)

-- Auto Farm Nearest
task.spawn(function()
    while true do
        if S.autoFarmNearest and not farmPriorityBlocked() then
            local char = LocalPlayer.Character
