                accent.Position = Vector2.new(math.floor(viewportX / 2) - 110, math.floor(viewportY / 2) - 76)
                title.Position = Vector2.new(viewportX / 2, math.floor(viewportY / 2) - 55)
                message.Position = Vector2.new(viewportX / 2, math.floor(viewportY / 2) - 8)
                linkText.Position = Vector2.new(viewportX / 2, math.floor(viewportY / 2) + 28)
                copyButton.Position = Vector2.new(buttonX, buttonY)
