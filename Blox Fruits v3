            if hrp then
                if not getHeldTool() then pressWeaponSlot(S.weaponSlot) end
                local enemy = getNearestEnemy(hrp)
                if enemy then
                    local useRemote = S.remoteMode
                    local reached = false
                    local lastAttack = 0
                    while S.autoFarmNearest and S.remoteMode == useRemote and not farmPriorityBlocked() and isAlive(enemy) do
                        if not useRemote then
                            local head = enemy:FindFirstChild("Head")
                            if head then
                                pcall(function()
                                    head.Size = Vector3.new(50, 50, 50)
                                    head.CanCollide = false
                                end)
                            end
                        end
                        local root = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildOfClass("BasePart")
                        local position = safePosition(root)
                        if not position then break end
                        local offsetX, offsetY, offsetZ = getFarmOffsets()
                        local target = Vector3.new(
                            position.X + offsetX,
                            position.Y + offsetY,
                            position.Z + offsetZ
                        )
                        if not reached then
                            tweenTo(hrp, target, function()
                                return S.autoFarmNearest and S.remoteMode == useRemote and not farmPriorityBlocked() and isAlive(enemy)
                            end)
                            reached = true
                        else
                            pcall(function()
                                hrp.Position = target
                                hrp.Velocity = Vector3.new(0,0,0)
                                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                            end)
                        end

                        local now = os.clock()
                        if now - lastAttack >= (useRemote and 0.05 or 0.06) then
                            lastAttack = now
                            if useRemote then task.spawn(remoteAttack) else mouse1click() end
                        end
                        task.wait()
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

-- Fruit and chest ESP update loops
task.spawn(function()
    while true do
        if S.fruitEsp then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart") or nil
            local playerPosition = safePosition(hrp)
            for _, entry in pairs(S.espLabels) do
                local position = safePosition(entry.part)
                if position and playerPosition then
                    local dx = position.X - playerPosition.X
                    local dy = position.Y - playerPosition.Y
                    local dz = position.Z - playerPosition.Z
                    local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
                    if distance <= 10000 then
                        local okScreen, screenPosition, onScreen = pcall(function() return WorldToScreen(position) end)
                        entry.label.Visible = okScreen and onScreen or false
                        if okScreen and onScreen then entry.label.Position = Vector2.new(screenPosition.X, screenPosition.Y - 20) end
                    else
                        entry.label.Visible = false
                    end
                else
                    entry.label.Visible = false
                end
            end

            for _, entry in pairs(S.chamBoxes) do
                local position = safePosition(entry.part)
                local okSize, size = pcall(function() return entry.part.Size end)
                if position and okSize and size then
                    local halfX, halfY = size.X * 0.5, size.Y * 0.5
                    local points = {
                        Vector3.new(position.X-halfX, position.Y-halfY, position.Z),
                        Vector3.new(position.X+halfX, position.Y-halfY, position.Z),
                        Vector3.new(position.X-halfX, position.Y+halfY, position.Z),
                        Vector3.new(position.X+halfX, position.Y+halfY, position.Z),
                    }
                    local screens, visible = {}, false
                    for i, point in ipairs(points) do
                        local okScreen, screenPosition, onScreen = pcall(function() return WorldToScreen(point) end)
                        screens[i] = okScreen and screenPosition or nil
                        if okScreen and onScreen then visible = true end
                    end
                    if visible and screens[1] and screens[2] and screens[3] and screens[4] then
                        entry.lines[1].From, entry.lines[1].To = screens[1], screens[2]
                        entry.lines[2].From, entry.lines[2].To = screens[3], screens[4]
                        entry.lines[3].From, entry.lines[3].To = screens[1], screens[3]
                        entry.lines[4].From, entry.lines[4].To = screens[2], screens[4]
                        for _, line in pairs(entry.lines) do line.Visible = true end
                    else
                        for _, line in pairs(entry.lines) do line.Visible = false end
                    end
                end
            end
        end
        task.wait(0.05)
    end
end)

