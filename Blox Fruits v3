end

local function getFarmOffsets()
    local hasSanguine = false
    local char = LocalPlayer and LocalPlayer.Character or nil
    local backpack = LocalPlayer and LocalPlayer:FindFirstChild("Backpack") or nil

    local okSanguine = pcall(function()
        hasSanguine = (backpack and backpack:FindFirstChild("Sanguine Art") ~= nil)
            or (char and char:FindFirstChild("Sanguine Art") ~= nil)
    end)
    if not okSanguine then hasSanguine = false end

    return hasSanguine and 15 or 0, 23, 0
end

local function pressWeaponSlot(slot)
    local key = slot == 3 and 0x33 or 0x31
    pcall(function()
        setrobloxinput(true)
        keyrelease(key)
        task.wait(0.02)
        keypress(key)
        task.wait(0.1)
        keyrelease(key)
    end)
    if getHeldTool() then return true end

    -- Fallback for Matcha states that swallow synthetic hotbar input.
    local char = LocalPlayer and LocalPlayer.Character or nil
    local backpack = LocalPlayer and LocalPlayer:FindFirstChild("Backpack") or nil
    local humanoid = char and char:FindFirstChildOfClass("Humanoid") or nil
    if not char or not backpack then return false end

    local tools = {}
    local okChildren, children = pcall(function() return backpack:GetChildren() end)
    if okChildren and children then
        for _, candidate in pairs(children) do
            local okClass, className = pcall(function() return candidate.ClassName end)
            if okClass and className == "Tool" then table.insert(tools, candidate) end
        end
    end

    local tool = tools[slot]
    if not tool then return false end
    if humanoid then pcall(function() humanoid:EquipTool(tool) end) end
    local okParent, parent = pcall(function() return tool.Parent end)
    if okParent and parent == char then return true end
    pcall(function() tool.Parent = char end)
    okParent, parent = pcall(function() return tool.Parent end)
    return okParent and parent == char
end

local function isAlive(model)
    if not model then return false end
    local okParent, parent = pcall(function() return model.Parent end)
    if not okParent or not parent then return false end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local okHealth, health = pcall(function() return humanoid.Health end)
        if okHealth and health and health <= 0 then return false end
    end
    return true
end

-- Remote Mode
local REMOTE_SESSION_ID = "32501259"
local REMOTE_MAX_DISTANCE = 60
local registerAttack = nil
local registerHit = nil

local function ensureRemotes()
    if registerAttack and registerHit then return true end
    local modules = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net") or nil
    if not net then return false end
    registerAttack = net:FindFirstChild("RE/RegisterAttack")
    registerHit = net:FindFirstChild("RE/RegisterHit")
    return registerAttack ~= nil and registerHit ~= nil
end

local function remoteAttack()
    if not ensureRemotes() then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart") or nil
    local myPosition = hrp and safePosition(hrp) or nil
    local enemies = game.Workspace:FindFirstChild("Enemies")
    if not myPosition or not enemies then return end

    local hitTable, primaryPart = {}, nil
    for _, enemy in pairs(enemies:GetChildren()) do
        if isAlive(enemy) then
            local part = enemy:FindFirstChild("LeftLowerLeg")
                or enemy:FindFirstChild("Head")
                or enemy:FindFirstChild("HumanoidRootPart")
            local position = safePosition(part)
            if part and position then
                local dx = position.X - myPosition.X
                local dy = position.Y - myPosition.Y
                local dz = position.Z - myPosition.Z
                if math.sqrt(dx * dx + dy * dy + dz * dz) <= REMOTE_MAX_DISTANCE then
                    table.insert(hitTable, {enemy, part})
                    if not primaryPart then primaryPart = part end
                end
            end
        end
    end
    if #hitTable == 0 then return end
    pcall(function() registerAttack:FireServer(0.5) end)
    task.wait()
    pcall(function() registerHit:FireServer(primaryPart, hitTable, nil, REMOTE_SESSION_ID) end)
end

local function getNearestEnemy(hrp)
    local enemies = game.Workspace:FindFirstChild("Enemies")
    local myPosition = safePosition(hrp)
    if not enemies or not myPosition then return nil end
    local nearest, nearestDistance = nil, math.huge
    for _, enemy in pairs(enemies:GetChildren()) do
        if isAlive(enemy) then
            local root = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildOfClass("BasePart")
            local position = safePosition(root)
            if position then
                local dx = position.X - myPosition.X
                local dy = position.Y - myPosition.Y
                local dz = position.Z - myPosition.Z
                local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
                if distance < nearestDistance and distance <= 1000 then
                    nearest, nearestDistance = enemy, distance
                end
            end
        end
    end
    return nearest
end

-- ESP
function clearFruitEsp()
    for _, entry in pairs(S.espLabels) do if entry.label then entry.label.Visible = false end end
    for _, entry in pairs(S.chamBoxes) do
        for _, line in pairs(entry.lines or {}) do line.Visible = false end
    end
    S.espLabels, S.chamBoxes = {}, {}
end

function buildFruitEsp()
    clearFruitEsp()
    for _, fruit in pairs(getWorkspaceFruits()) do
        local key = instanceKey(fruit.part)
        if not S.espLabelCache[key] then
            local label = Drawing.new("Text")
            label.Text = fruit.name
            label.Color = Color3.fromRGB(0,255,90)
            label.Size = 14
            label.Outline = true
            label.Center = true
            label.Font = Drawing.Fonts.Monospace
            label.ZIndex = 10
            label.Visible = false
            S.espLabelCache[key] = {label = label, part = fruit.part}
        else
            S.espLabelCache[key].part = fruit.part
            S.espLabelCache[key].label.Text = fruit.name
        end
        table.insert(S.espLabels, S.espLabelCache[key])

        if not S.chamBoxCache[key] then
            local lines = {}
            for _ = 1, 4 do
                local line = Drawing.new("Line")
                line.Color = Color3.fromRGB(0,255,90)
                line.Thickness = 2
                line.ZIndex = 9
                line.Visible = false
                table.insert(lines, line)
            end
            S.chamBoxCache[key] = {lines = lines, part = fruit.part}
        else
            S.chamBoxCache[key].part = fruit.part
        end
        table.insert(S.chamBoxes, S.chamBoxCache[key])
    end
end

function clearChestEsp()
    for _, entry in pairs(S.chestEspLabels) do if entry.label then entry.label.Visible = false end end
    S.chestEspLabels = {}
end

function buildChestEsp()
    clearChestEsp()
    local chestModels = game.Workspace:FindFirstChild("ChestModels")
    if not chestModels then return end
    for _, chest in pairs(chestModels:GetChildren()) do
        local part = chest:FindFirstChild("RootPart") or chest:FindFirstChildOfClass("BasePart")
        if safePosition(part) then
            local key = instanceKey(part)
            local okName, name = pcall(function() return chest.Name end)
            name = (okName and name and name ~= "") and name or "Chest"
            local color = Color3.fromRGB(235,235,235)
            if name == "SilverChest" then color = Color3.fromRGB(165,165,165)
            elseif name == "GoldChest" then color = Color3.fromRGB(255,215,55)
            elseif name == "DiamondChest" then color = Color3.fromRGB(85,205,255) end
            if not S.chestEspLabelCache[key] then
                local label = Drawing.new("Text")
                label.Text = name
                label.Color = color
                label.Size = 14
                label.Outline = true
                label.Center = true
                label.Font = Drawing.Fonts.Monospace
                label.ZIndex = 10
                label.Visible = false
                S.chestEspLabelCache[key] = {label = label, part = part}
            else
                S.chestEspLabelCache[key].part = part
                S.chestEspLabelCache[key].label.Text = name
                S.chestEspLabelCache[key].label.Color = color
            end
            table.insert(S.chestEspLabels, S.chestEspLabelCache[key])
        end
    end
end

