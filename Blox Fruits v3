-- Shared helpers
local function safePosition(instance)
    if not instance then return nil end
    local okParent, parent = pcall(function() return instance.Parent end)
    if not okParent or not parent then return nil end
    local okPosition, position = pcall(function() return instance.Position end)
    if okPosition and position and position.X and position.Y and position.Z then return position end
    return nil
end

local function resolveFruitPart(root)
    if not root then return nil end
    local okClass, className = pcall(function() return root.ClassName end)
    if okClass and className == "Tool" then
        local okHandle, handle = pcall(function() return root:FindFirstChild("Handle") end)
        if okHandle and handle and safePosition(handle) then return handle end
        local okPart, part = pcall(function() return root:FindFirstChildOfClass("BasePart") end)
        if okPart and part and safePosition(part) then return part end
    end
    if safePosition(root) then return root end
    for _, childName in pairs({"Handle", "Fruit"}) do
        local okChild, child = pcall(function() return root:FindFirstChild(childName) end)
        if okChild and child then
            if safePosition(child) then return child end
            local okInner, inner = pcall(function() return child:FindFirstChild("Fruit") end)
            if okInner and inner and safePosition(inner) then return inner end
        end
    end
    local okDesc, descendants = pcall(function() return root:GetDescendants() end)
    if okDesc and descendants then
        for _, descendant in pairs(descendants) do
            if safePosition(descendant) then return descendant end
        end
    end
    return nil
end

local function instanceKey(instance)
    local okAddress, address = pcall(function() return instance.Address end)
    if okAddress and address and address ~= 0 then return "addr:" .. tostring(address) end
    local position = safePosition(instance)
    if position then
        return tostring(instance) .. ":" .. tostring(position.X) .. ":" .. tostring(position.Y) .. ":" .. tostring(position.Z)
    end
    return tostring(instance)
end

local function getWorkspaceFruits()
    local fruits, seen = {}, {}
    local okChildren, children = pcall(function() return game.Workspace:GetChildren() end)
    if not okChildren or not children then return fruits end

    local function addFruit(root, name)
        local part = resolveFruitPart(root)
        local position = safePosition(part)
        if not part or not position then return end
        local key = instanceKey(part)
        if seen[key] then return end
        for _, existing in pairs(fruits) do
            local existingPosition = existing.position or safePosition(existing.part)
            if existingPosition then
                local dx = position.X - existingPosition.X
                local dy = position.Y - existingPosition.Y
                local dz = position.Z - existingPosition.Z
                if dx * dx + dy * dy + dz * dz <= 9 then return end
            end
        end
        seen[key] = true
        table.insert(fruits, {part = part, position = position, name = name or "Spawned Fruit"})
    end

    for _, object in pairs(children) do
        local okName, objectName = pcall(function() return object.Name end)
        objectName = okName and objectName or ""
        if string.match(string.lower(objectName), "fruit") then addFruit(object, objectName) end
        local okFolder, fruitFolder = pcall(function() return object:FindFirstChild("Fruit") end)
        if okFolder and fruitFolder then addFruit(fruitFolder, objectName ~= "" and objectName or "Spawned Fruit") end
    end
    return fruits
end

local function tweenTo(hrp, targetPosition, checkFunction)
    if not hrp or not targetPosition then return end
    local okStart, startPosition = pcall(function() return hrp.Position end)
    if not okStart or not startPosition then return end
    local dx = targetPosition.X - startPosition.X
    local dy = targetPosition.Y - startPosition.Y
    local dz = targetPosition.Z - startPosition.Z
    local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
    if distance <= 1 then
        pcall(function() hrp.Position = targetPosition end)
        return
    end
    local duration = distance / 320
    local startedAt = os.clock()
    while true do
        if checkFunction and not checkFunction() then return end
        local okParent, parent = pcall(function() return hrp.Parent end)
        if not okParent or not parent then return end
        local alpha = math.min((os.clock() - startedAt) / duration, 1)
        local newPosition = Vector3.new(
            startPosition.X + dx * alpha,
            startPosition.Y + dy * alpha,
            startPosition.Z + dz * alpha
        )
        local okMove = pcall(function()
            hrp.Position = newPosition
            hrp.Velocity = Vector3.new(0,0,0)
            hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end)
        if not okMove or alpha >= 1 then break end
        task.wait(0.01)
    end
end

