local Library = WabiSabiUILibrary
if not Library then
    local uiUrls = {
        "https://raw.githubusercontent.com/myth4c/Scripts2/refs/heads/main/wabisabi%20lib",
    }
    local lastError = "no valid UI response"

    for _, uiUrl in ipairs(uiUrls) do
        local okFetch, source = pcall(function() return game:HttpGet(uiUrl) end)
        if okFetch and type(source) == "string" then
            local trimmed = string.match(source, "^%s*(.-)%s*$") or source
            local looksValid = #source > 1000
                and string.sub(trimmed, 1, 3) ~= "404"
                and not string.match(string.lower(trimmed), "^not found")

            if looksValid then
                local loader = nil
                local parseError = nil
                local okParse = pcall(function()
                    loader, parseError = loadstring(source, "WabiSabiUI")
                end)
                if okParse and type(loader) == "function" then
                    local okRun, result = pcall(loader)
                    if okRun then
                        Library = result or WabiSabiUILibrary
                        if Library then break end
                    else
                        lastError = "UI runtime error: " .. tostring(result)
                    end
                else
                    lastError = "UI parse error: " .. tostring(parseError)
                end
            else
                lastError = "invalid response from " .. uiUrl
            end
        else
            lastError = "download failed from " .. uiUrl .. ": " .. tostring(source)
        end
    end

    if not Library then
        warn("Failed to load WabiSabi UI: " .. lastError)
        notify("UI download failed. Try running the script again.", "laced.lol", 6)
        return
    end
end

